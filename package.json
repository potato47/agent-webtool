{
  "name": "agent-webtool",
  "version": "0.6.0",
  "description": "Web fetch and multi-engine search tools for AI agents (SDK + CLI + MCP server). No API keys required.",
  "keywords": [
    "agent",
    "ai",
    "baidu",
    "claude",
    "duckduckgo",
    "llm",
    "mcp",
    "scraping",
    "tools",
    "toutiao",
    "web-fetch",
    "web-search",
    "wechat"
  ],
  "homepage": "https://github.com/potato47/agent-webtool#readme",
  "bugs": {
    "url": "https://github.com/potato47/agent-webtool/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/potato47/agent-webtool.git"
  },
  "bin": {
    "agent-webtool": "./dist/cli.mjs",
    "webtool": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "bun run build:cli && bun run build:sdk",
    "build:cli": "bun build bin/cli.ts --target=node --format=esm --outfile=dist/cli.mjs && chmod +x dist/cli.mjs",
    "build:sdk": "bun run clean:types && bun build src/index.ts --target=node --format=esm --packages=external --outfile=dist/index.mjs && bun build src/index.ts --target=node --format=cjs --packages=external --outfile=dist/index.cjs && tsc -p tsconfig.sdk.json",
    "clean:types": "node -e \"require('node:fs').rmSync('dist/types', { recursive: true, force: true })\"",
    "cli": "bun bin/cli.ts",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "mcp": "bun bin/cli.ts mcp",
    "test": "bun test test/",
    "verify:sdk": "node test/sdk-smoke.mjs && node test/sdk-smoke.cjs && tsc --noEmit --module NodeNext --moduleResolution NodeNext --target ES2022 --skipLibCheck test/sdk-consumer.ts",
    "prepublishOnly": "bun run build && bun test test/ && bun run verify:sdk"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "marked": "^18.0.4",
    "marked-terminal": "^7.3.0",
    "turndown": "^7.2.4",
    "undici": "^7.25.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/bun": "latest",
    "@types/marked-terminal": "^6.1.1",
    "@types/turndown": "^5.0.6",
    "commander": "^14.0.3",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.18.1"
  }
}
